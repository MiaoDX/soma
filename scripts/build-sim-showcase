#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then echo "usage: scripts/build-sim-showcase OUTPUT_DIR" >&2; exit 2; fi
repo_root=$(cd "$(dirname "$0")/.." && pwd)
source "$repo_root/scripts/sim-stack.sh"
output_dir=$(realpath -m "$1")
if [[ -e $output_dir ]]; then
  echo "output path already exists: $output_dir" >&2
  exit 2
fi
frames_dir="$output_dir/frames"
snapshots_file="$output_dir/reachy-snapshots.csv"
telemetry_rrd="$output_dir/telemetry.rrd"
robot_rrd="$output_dir/reachy-model.rrd"
socket_path="/tmp/soma-showcase-$$.sock"
rt_log=$(mktemp /tmp/soma-showcase-rt.XXXXXX.log)
runtime_log=$(mktemp /tmp/soma-showcase-runtime.XXXXXX.log)
observer_log=$(mktemp /tmp/soma-showcase-observer.XXXXXX.log)

cleanup() {
  local remove_rt_socket=false
  local remove_runtime_socket=false
  sim_stack_lock_names_pid "${rt_pid:-}" /tmp/soma-robot-rt.sock.lock && remove_rt_socket=true
  sim_stack_lock_names_pid "${runtime_pid:-}" /tmp/soma-robot-runtime.sock.lock && remove_runtime_socket=true
  kill "${rt_pid:-}" "${runtime_pid:-}" "${observer_pid:-}" "${scenario_pid:-}" 2>/dev/null || true
  wait "${rt_pid:-}" "${runtime_pid:-}" "${observer_pid:-}" "${scenario_pid:-}" 2>/dev/null || true
  $remove_rt_socket && rm -f /tmp/soma-robot-rt.sock
  $remove_runtime_socket && rm -f /tmp/soma-robot-runtime.sock
  rm -f "$socket_path" "$socket_path.lock" "$socket_path.ready" "$socket_path.ready.lock" "$rt_log" "$runtime_log" "$observer_log"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

mkdir -p "$frames_dir"
"$repo_root/scripts/cargo-mujoco" build --quiet --release -p soma-runtime --features sim-showcase --bin robot-rt --bin robot-runtime --bin robot-sim-observer
export LD_LIBRARY_PATH="$repo_root/.mujoco/mujoco-3.9.0/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
"$repo_root/target/release/robot-runtime" >"$runtime_log" 2>&1 & runtime_pid=$!
"$repo_root/target/release/robot-sim-observer" --snapshot-socket "$socket_path" \
  --rerun-file "$telemetry_rrd" --frames-dir "$frames_dir" \
  --snapshots-file "$snapshots_file" >"$observer_log" 2>&1 & observer_pid=$!
for _ in $(seq 1 100); do [[ -S $socket_path && -f $socket_path.ready ]] && break; kill -0 "$observer_pid" 2>/dev/null || { cat "$observer_log" >&2; exit 1; }; sleep 0.1; done
[[ -S $socket_path && -f $socket_path.ready ]] || { cat "$observer_log" >&2; echo "showcase observer did not become ready" >&2; exit 1; }
"$repo_root/target/release/robot-rt" --observe-socket "$socket_path" >"$rt_log" 2>&1 & rt_pid=$!
for _ in $(seq 1 50); do sim_stack_fixed_endpoints_owned "$rt_pid" "$runtime_pid" && break; sleep 0.1; done
sim_stack_fixed_endpoints_owned "$rt_pid" "$runtime_pid" || { cat "$rt_log" "$runtime_log" >&2; echo "showcase stack did not become ready" >&2; exit 1; }
(cd "$repo_root/python" && timeout 25 env UV_DEFAULT_INDEX=https://pypi.org/simple uv run python -m soma_client.scenario \
  --showcase "$repo_root/crates/soma-sim/assets/reachy-mini/kinematics_data.json") & scenario_pid=$!
wait "$observer_pid" || { cat "$observer_log" >&2; exit 1; }
wait "$scenario_pid"

(
  cd "$repo_root/crates/soma-sim/assets/reachy-mini"
  UV_DEFAULT_INDEX=https://pypi.org/simple uv run --project "$repo_root/python" \
    --extra visualization python - "$snapshots_file" "$robot_rrd" <<'PY'
import pathlib
import sys

import mujoco
import numpy as np
import rerun as rr
import rerun.blueprint as rrb
from rerun_loader_mjcf import MJCFLogger, MJCFRecorder

samples = np.loadtxt(sys.argv[1], delimiter=",", skiprows=1, ndmin=2)
if samples.shape[1] != 41 or samples.shape[0] < 2:
    raise SystemExit(f"unexpected Reachy snapshot trace shape: {samples.shape}")

model = mujoco.MjModel.from_xml_path("reachy_mini.xml")
if (model.nq, model.nv) != (37, 30):
    raise SystemExit(f"unexpected Reachy model dimensions: {(model.nq, model.nv)}")
data = mujoco.MjData(model)

rr.init("soma_simulation", recording_id="reachy-showcase")
rr.set_time("program_time", duration=float(samples[0, 0]))
logger = MJCFLogger(model, entity_path_prefix="robot")
logger.log_model()

with MJCFRecorder(logger, timeline_name="program_time") as recorder:
    for sample in samples:
        data.qpos[:] = sample[4:]
        data.time = float(sample[1])
        mujoco.mj_forward(model, data)
        recorder.record(data, duration=float(sample[0]))

spatial = rrb.Spatial3DView(
    origin="robot",
    contents=["/robot/**"],
    name="Reachy Mini",
    eye_controls=rrb.EyeControls3D(
        position=(0.48, -0.12, 0.322),
        look_target=(0.0, 0.0, 0.205),
        eye_up=(0.0, 0.0, 1.0),
    ),
)
telemetry = rrb.Vertical(
    rrb.TimeSeriesView(origin="actuators/yaw_body", name="Body yaw"),
    rrb.TimeSeriesView(
        contents=[f"/actuators/stewart_{index}/**" for index in range(1, 7)],
        name="Stewart motors",
    ),
    rrb.TimeSeriesView(
        contents=["/actuators/left_antenna/**", "/actuators/right_antenna/**"],
        name="Antennae",
    ),
    rrb.Tabs(
        rrb.StateTimelineView(origin="state", name="Control state"),
        rrb.TextLogView(origin="events", name="Events"),
        name="State and events",
    ),
)
rr.send_blueprint(
    rrb.Blueprint(rrb.Horizontal(spatial, telemetry, column_shares=[1.2, 1.0]))
)
rr.save(sys.argv[2])
PY
)

(
  cd "$repo_root/python"
  UV_DEFAULT_INDEX=https://pypi.org/simple uv run --extra visualization rerun rrd merge \
    -o "$output_dir/evidence.rrd" "$telemetry_rrd" "$robot_rrd"
)
rm -f "$snapshots_file" "$telemetry_rrd" "$robot_rrd"

ffmpeg=$(cd "$repo_root/python" && UV_DEFAULT_INDEX=https://pypi.org/simple \
  uv run --extra visualization python -c 'import imageio_ffmpeg; print(imageio_ffmpeg.get_ffmpeg_exe())')
cp "$frames_dir/frame-0000.png" "$output_dir/poster.png"
frame_count=$(printf '%s\n' "$frames_dir"/frame-*.png | wc -l)
if (( frame_count < 2 )); then
  echo "showcase capture produced fewer than two frames" >&2
  exit 1
fi
# The observer is intentionally lossy, so software-rendering throughput changes
# the frame count. Map the continuous capture to its deterministic 14-second span.
"$ffmpeg" -hide_banner -loglevel error -framerate "$frame_count/14" -i "$frames_dir/frame-%04d.png" -c:v libvpx-vp9 -pix_fmt yuv420p -an -y "$output_dir/motion.webm"
rm -rf "$frames_dir"
commit=$(git -C "$repo_root" rev-parse HEAD)
generated=$(date -u +%Y-%m-%dT%H:%M:%SZ)
rrd_url="https://miaodx.com/soma/reachy/evidence.rrd"
sed -e "s/@@COMMIT@@/$commit/g" -e 's/@@ROBOT@@/Reachy Mini/g' -e "s#@@RRD_URL@@#$rrd_url#g" "$repo_root/docs/showcase/index.template.html" >"$output_dir/index.html"
(
cd "$repo_root/python"
uv run python - "$output_dir/metadata.json" "$commit" "$generated" "$repo_root/crates/soma-sim/assets/reachy-mini/kinematics_data.json" <<'PY'
import json,sys
from pathlib import Path
from soma_client.showcase import DURATION_SECONDS, SAMPLE_HZ, keyframes
poses=keyframes(Path(sys.argv[4]))
ranges=[max(p.positions[i] for p in poses)-min(p.positions[i] for p in poses) for i in range(9)]
json.dump({"schema_version":1,"robot":"Reachy Mini","scope":"simulation-only","scenario":"deterministic 12-second Pages choreography plus acceptance proof","scenario_result":"passed","commit":sys.argv[2],"generated_utc":sys.argv[3],"choreography":{"duration_seconds":DURATION_SECONDS,"capture_duration_seconds":14.0,"sample_hz":SAMPLE_HZ,"pose_order":[p.name for p in poses],"target_ranges_rad":ranges,"complete_target_positions":9},"renderer":{"engine":"mujoco-rs MjRenderer EGL offscreen","camera_id":0,"camera_name":"studio_close","width":640,"height":480},"rerun_3d":{"source":"compiled Reachy Mini MJCF robot model","loader":"rerun-loader-mjcf","loader_version":"1.0.1","timeline":"program_time"},"artifacts":{"poster":"poster.png","motion":"motion.webm","rerun":"evidence.rrd"}},open(sys.argv[1],"w"),indent=2)
PY
)
"$repo_root/scripts/verify-sim-showcase" "$output_dir"
echo "showcase built and verified: $output_dir"
