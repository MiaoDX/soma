#!/usr/bin/env python3
"""Open Duck Mini v2 reference and policy rollout entry point."""
import argparse, hashlib, json, math, os, signal, subprocess, sys, time
from pathlib import Path
import mujoco
import numpy as np
import onnxruntime as ort

GAIT_PHASE_PERIOD = 27

ROOT = Path(__file__).resolve().parents[1]
BUNDLE = ROOT / "crates/soma-sim/assets/open-duck-mini-v2"
JOINTS = ["left_hip_yaw", "left_hip_roll", "left_hip_pitch", "left_knee", "left_ankle", "neck_pitch", "head_pitch", "head_yaw", "head_roll", "right_hip_yaw", "right_hip_roll", "right_hip_pitch", "right_knee", "right_ankle"]

def main():
    p = argparse.ArgumentParser()
    p.add_argument("mode", choices=["reference", "policy", "stall"])
    p.add_argument("--case", default=str(ROOT / "docs/status/active/open-duck-stage0-case.md"))
    p.add_argument("--repeat", type=int, default=1)
    p.add_argument("--checkpoint", type=Path, default=BUNDLE / "BEST_WALK_ONNX.onnx")
    p.add_argument("--experimental-checkpoint-sha256", help=argparse.SUPPRESS)
    p.add_argument("--vx", type=float, default=0.3)
    p.add_argument("--visualize", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--diagnostic-delay-steps", type=int, default=0, help=argparse.SUPPRESS)
    p.add_argument("--diagnostic-drop-policy-tick", type=int, help=argparse.SUPPRESS)
    args = p.parse_args()
    checkpoint = args.checkpoint.resolve()
    digest = hashlib.sha256(checkpoint.read_bytes()).hexdigest()
    expected = {"3c606f9381a1710cc8fecdb7442787dcbfce3ee9bc02a6f1224774ab2b3a1067", "cb61453a8bcb547ccfdeb4f03ba0fa67ebcf767dcf4aa6e5c9a0d92b302f9b23"}
    experimental = args.experimental_checkpoint_sha256
    if (digest not in expected and digest != experimental) or "FROZEN" not in Path(args.case).read_text():
        raise SystemExit("refusing rollout: frozen case or pinned checkpoint is invalid")
    if args.mode in {"policy", "stall"}:
        run_process_mode(args)
        return
    model_file = BUNDLE / "xmls/scene_flat_terrain.xml"
    # MuJoCo resolves mesh includes relative to the scene XML directory.
    os.chdir(model_file.parent)
    model = mujoco.MjModel.from_xml_path(model_file.name)
    if (model.nq, model.nv, model.nu) != (21, 20, 14):
        raise SystemExit(f"unexpected model dimensions: {model.nq, model.nv, model.nu}")
    names = [mujoco.mj_id2name(model, mujoco.mjtObj.mjOBJ_ACTUATOR, i) for i in range(model.nu)]
    if names != JOINTS:
        raise SystemExit(f"actuator order mismatch: {names}")
    session = ort.InferenceSession(str(checkpoint), providers=["CPUExecutionProvider"])
    if session.get_inputs()[0].shape != [1, 101] or session.get_outputs()[0].shape != [1, 14]:
        raise SystemExit("unexpected ONNX contract")
    results = []
    floor_geom = mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_GEOM, "floor")
    foot_geoms = [mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_GEOM, name)
                  for name in ("left_foot_bottom_tpu", "right_foot_bottom_tpu")]
    for run in range(args.repeat):
        data = mujoco.MjData(model)
        mujoco.mj_resetDataKeyframe(model, data, mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_KEY, "home"))
        default = data.ctrl.copy()
        history = [np.zeros(14, dtype=np.float32) for _ in range(3)]
        target = default.copy()
        previous = target.copy()
        x0 = float(data.qpos[0])
        max_abs_angle = 0.0
        min_root_height = float("inf"); max_abs_roll = 0.0; max_abs_pitch = 0.0
        contacts = [0, 0]
        obs_fixture = action_fixture = None
        phase = np.zeros(2, dtype=np.float32)
        delayed_targets = []
        for tick in range(4000):
            mujoco.mj_step(model, data)
            while delayed_targets and delayed_targets[0][0] <= tick:
                _, ready_target = delayed_targets.pop(0); data.ctrl[:] = ready_target
            if tick % 10: continue
            policy_tick = tick // 10
            if args.diagnostic_drop_policy_tick == policy_tick: continue
            gyro = data.sensordata[0:3].astype(np.float32)
            accel = data.sensordata[6:9].astype(np.float32).copy(); accel[0] += 1.3
            qpos = np.array([data.qpos[model.jnt_qposadr[mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_JOINT, n)]] for n in JOINTS], dtype=np.float32)
            qvel = np.array([data.qvel[model.jnt_dofadr[mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_JOINT, n)]] for n in JOINTS], dtype=np.float32)
            contacts = np.array([any(
                (contact.geom1 == foot and contact.geom2 == floor_geom) or
                (contact.geom2 == foot and contact.geom1 == floor_geom)
                for contact in data.contact) for foot in foot_geoms], dtype=np.float32)
            obs = np.concatenate((gyro, accel, np.array([args.vx,0,0,0,0,0,0], dtype=np.float32), qpos-default.astype(np.float32), qvel*0.05, *history, target.astype(np.float32), contacts, phase)).astype(np.float32)
            if obs.size != 101: raise SystemExit(f"observation width {obs.size}")
            action = session.run(None, {"obs": obs[None, :]})[0][0].astype(np.float32)
            if not np.isfinite(action).all(): raise SystemExit("non-finite policy output")
            history = [action, *history[:2]]
            phase_i = (tick // 10 + 1) % GAIT_PHASE_PERIOD
            phase = np.array([math.cos(phase_i / GAIT_PHASE_PERIOD * 2 * math.pi), math.sin(phase_i / GAIT_PHASE_PERIOD * 2 * math.pi)], dtype=np.float32)
            proposed = default + action * 0.25
            limit = 5.24 * 0.02
            target = np.clip(proposed, previous-limit, previous+limit); previous = target.copy()
            delayed_targets.append((tick + args.diagnostic_delay_steps, target.copy()))
            while delayed_targets and delayed_targets[0][0] <= tick:
                _, ready_target = delayed_targets.pop(0); data.ctrl[:] = ready_target
            if tick == 0: obs_fixture, action_fixture = obs.tolist(), action.tolist()
            max_abs_angle = max(max_abs_angle, float(np.max(np.abs(data.qpos[7:]))))
            w,x,y,z=data.qpos[3:7]; roll=math.atan2(2*(w*x+y*z),1-2*(x*x+y*y)); pitch=math.asin(np.clip(2*(w*y-z*x),-1,1))
            min_root_height=min(min_root_height,float(data.qpos[2])); max_abs_roll=max(max_abs_roll,abs(roll)); max_abs_pitch=max(max_abs_pitch,abs(pitch))
        results.append({"run": run, "physics_steps": 4000, "policy_ticks": 400, "command_vx_mps": args.vx, "forward_displacement_m": float(data.qpos[0]-x0), "max_abs_joint_angle_rad": max_abs_angle, "min_root_height_m":min_root_height,"max_abs_roll_rad":max_abs_roll,"max_abs_pitch_rad":max_abs_pitch, "observation_width": len(obs_fixture), "action_width": len(action_fixture), "first_observation": obs_fixture, "first_action": action_fixture, "mode": args.mode})
    print(json.dumps({"contract": {"nq":21,"nv":20,"nu":14,"observation":101,"action":14,"timestep":0.002}, "runs": results}, indent=2))

def run_process_mode(args):
    env = os.environ.copy()
    env["LD_LIBRARY_PATH"] = str(ROOT / ".mujoco/mujoco-3.9.0/lib") + ":" + env.get("LD_LIBRARY_PATH", "")
    procs = []
    try:
        procs.append(subprocess.Popen([str(ROOT / "target/debug/open-duck-runtime")], env=env,
                                      stdout=subprocess.DEVNULL, stderr=subprocess.PIPE))
        time.sleep(0.2)
        policy_python = ROOT / "python/.venv/bin/python"
        duration = "2" if args.mode == "stall" else "8"
        policy = [str(policy_python), "-m", "soma_client.open_duck_policy", "--duration", duration,
                  "--checkpoint", str(args.checkpoint.resolve())]
        if args.mode == "stall": policy += ["--stall-after", "1"]
        proc = subprocess.Popen(policy, cwd=ROOT / "python", env={**env, "PYTHONPATH": "."},
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        procs.append(proc)
        time.sleep(0.1)
        procs.append(subprocess.Popen([str(ROOT / "target/debug/open-duck-rt")], env=env,
                                      stdout=subprocess.DEVNULL, stderr=subprocess.PIPE))
        out, err = proc.communicate(timeout=15)
        if proc.returncode != 0:
            raise SystemExit(err.strip() or "Open Duck policy process failed")
        try:
            evidence = json.loads(out.strip().splitlines()[-1])
        except (json.JSONDecodeError, IndexError):
            raise SystemExit("Open Duck policy process did not report JSON evidence")
        if "complete" not in evidence.get("status", ""):
            raise SystemExit("Open Duck policy process did not report completion")
        if not evidence.get("applied"):
            raise SystemExit("Open Duck process path never observed an applied target")
        if args.mode == "stall" and not evidence.get("expiry"):
            raise SystemExit("Open Duck stall did not observe the expiry transition")
        if args.mode == "policy":
            if evidence["min_root_height_m"] < 0.08:
                raise SystemExit(f"Open Duck process rollout violated root-height floor: {evidence}")
            if evidence["max_abs_roll_rad"] > 0.8 or evidence["max_abs_pitch_rad"] > 0.8:
                raise SystemExit("Open Duck process rollout violated roll/pitch envelope")
        print(json.dumps({"mode": args.mode, "process_path": True, "evidence": evidence}))
    finally:
        for proc in procs:
            if proc.poll() is None: proc.send_signal(signal.SIGINT)
        for proc in procs:
            try: proc.wait(timeout=2)
            except subprocess.TimeoutExpired: proc.kill()

if __name__ == "__main__": main()
