#!/usr/bin/env python3
"""Open Duck Mini v2 reference and policy rollout entry point."""
import argparse, hashlib, json, math, os, signal, subprocess, sys, time, tomllib
from pathlib import Path
import mujoco
import numpy as np
import onnxruntime as ort

GAIT_PHASE_PERIOD = 27
FROZEN_CASE_SHA256 = "59a29cb8ba9acc460267be7cd4929fcf7344cfe031cd19490247c14bf3c6a184"

ROOT = Path(__file__).resolve().parents[1]
BUNDLE = ROOT / "crates/soma-sim/assets/open-duck-mini-v2"
JOINTS = ["left_hip_yaw", "left_hip_roll", "left_hip_pitch", "left_knee", "left_ankle", "neck_pitch", "head_pitch", "head_yaw", "head_roll", "right_hip_yaw", "right_hip_roll", "right_hip_pitch", "right_knee", "right_ankle"]

def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()

def validate_frozen_inputs(case: Path, checkpoint: Path, experimental: str | None) -> None:
    if sha256(case) != FROZEN_CASE_SHA256:
        raise SystemExit("refusing rollout: frozen case checksum mismatch")
    manifest_path = BUNDLE / "PROVENANCE.toml"
    manifest = tomllib.loads(manifest_path.read_text())
    expected_files = manifest.get("files")
    if not isinstance(expected_files, dict) or not expected_files:
        raise SystemExit("refusing rollout: provenance file ledger is missing")
    actual_files = {
        path.relative_to(BUNDLE).as_posix()
        for path in BUNDLE.rglob("*")
        if path.is_file() and path != manifest_path
    }
    if actual_files != set(expected_files):
        raise SystemExit("refusing rollout: provenance file ledger is incomplete")
    for relative, expected_digest in expected_files.items():
        if sha256(BUNDLE / relative) != expected_digest:
            raise SystemExit(f"refusing rollout: provenance checksum mismatch: {relative}")
    digest = sha256(checkpoint)
    approved = {source.get("sha256") for source in manifest.get("source", [])}
    if digest not in approved and digest != experimental:
        raise SystemExit("refusing rollout: checkpoint is not approved")

def validate_frozen_run(run: dict[str, object]) -> None:
    failures = []
    if run["physics_steps"] < 3750: failures.append("duration")
    if run["forward_displacement_m"] < 0.10: failures.append("forward displacement")
    if run["min_root_height_m"] < 0.08: failures.append("root height")
    if run["max_abs_roll_rad"] > 0.8: failures.append("roll")
    if run["max_abs_pitch_rad"] > 0.8: failures.append("pitch")
    if run["non_foot_collision_count"] != 0: failures.append("non-foot collision")
    if failures:
        raise SystemExit("Open Duck frozen acceptance failed: " + ", ".join(failures))

def main():
    p = argparse.ArgumentParser()
    p.add_argument("mode", choices=["reference", "policy", "stall"])
    p.add_argument("--case", default=str(ROOT / "docs/status/active/open-duck-stage0-case.md"))
    p.add_argument("--repeat", type=int, default=1)
    p.add_argument("--checkpoint", type=Path, default=BUNDLE / "BEST_WALK_ONNX.onnx")
    p.add_argument("--experimental-checkpoint-sha256", help=argparse.SUPPRESS)
    p.add_argument("--vx", type=float, default=0.3)
    p.add_argument("--visualize", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--frames-dir", type=Path, help=argparse.SUPPRESS)
    p.add_argument("--trace-file", type=Path, help=argparse.SUPPRESS)
    p.add_argument("--diagnostic-delay-steps", type=int, default=0, help=argparse.SUPPRESS)
    p.add_argument("--diagnostic-drop-policy-tick", type=int, help=argparse.SUPPRESS)
    args = p.parse_args()
    checkpoint = args.checkpoint.resolve()
    validate_frozen_inputs(Path(args.case), checkpoint, args.experimental_checkpoint_sha256)
    if args.mode in {"policy", "stall"}:
        run_process_mode(args)
        return
    model_file = BUNDLE / "xmls/scene_flat_terrain.xml"
    # MuJoCo resolves mesh includes relative to the scene XML directory.
    os.chdir(model_file.parent)
    model = mujoco.MjModel.from_xml_path(model_file.name)
    if (model.nq, model.nv, model.nu) != (21, 20, 14):
        raise SystemExit(f"unexpected model dimensions: {model.nq, model.nv, model.nu}")
    names = [mujoco.mj_id2name(model, mujoco.mjtObj.mjOBJ_ACTUATOR, i) for i in range(model.nu)]
    if names != JOINTS:
        raise SystemExit(f"actuator order mismatch: {names}")
    session = ort.InferenceSession(str(checkpoint), providers=["CPUExecutionProvider"])
    if session.get_inputs()[0].shape != [1, 101] or session.get_outputs()[0].shape != [1, 14]:
        raise SystemExit("unexpected ONNX contract")
    results = []
    traces = []
    renderer = mujoco.Renderer(model, height=480, width=640) if args.frames_dir else None
    camera = mujoco.MjvCamera()
    camera.type = mujoco.mjtCamera.mjCAMERA_TRACKING
    camera.trackbodyid = mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_BODY, "base")
    camera.distance = 0.8
    camera.azimuth = 90
    camera.elevation = -15
    if args.frames_dir:
        args.frames_dir.mkdir(parents=True, exist_ok=True)
    floor_geom = mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_GEOM, "floor")
    foot_geoms = [mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_GEOM, name)
                  for name in ("left_foot_bottom_tpu", "right_foot_bottom_tpu")]
    foot_sites = [mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_SITE, name)
                  for name in ("left_foot", "right_foot")]
    for run in range(args.repeat):
        trace = []
        data = mujoco.MjData(model)
        mujoco.mj_resetDataKeyframe(model, data, mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_KEY, "home"))
        default = data.ctrl.copy()
        history = [np.zeros(14, dtype=np.float32) for _ in range(3)]
        target = default.copy()
        previous = target.copy()
        x0 = float(data.qpos[0])
        max_abs_angle = 0.0
        min_root_height = float("inf"); max_abs_roll = 0.0; max_abs_pitch = 0.0
        contacts = np.zeros(2, dtype=bool)
        previous_contacts = contacts.copy()
        contact_transitions = 0
        max_stance_slip_m = 0.0
        previous_foot_xy = None
        non_foot_collision_count = 0
        obs_fixture = action_fixture = None
        phase = np.zeros(2, dtype=np.float32)
        delayed_targets = []
        for tick in range(4000):
            mujoco.mj_step(model, data)
            if renderer is not None and run == 0 and tick % 40 == 0:
                renderer.update_scene(data, camera=camera)
                pixels = renderer.render()
                frame = args.frames_dir / f"frame-{tick // 40:04d}.ppm"
                with frame.open("wb") as stream:
                    stream.write(f"P6\n{pixels.shape[1]} {pixels.shape[0]}\n255\n".encode())
                    stream.write(pixels.tobytes())
            while delayed_targets and delayed_targets[0][0] <= tick:
                _, ready_target = delayed_targets.pop(0); data.ctrl[:] = ready_target
            if tick % 10: continue
            policy_tick = tick // 10
            if args.diagnostic_drop_policy_tick == policy_tick: continue
            gyro = data.sensordata[0:3].astype(np.float32)
            accel = data.sensordata[6:9].astype(np.float32).copy(); accel[0] += 1.3
            qpos = np.array([data.qpos[model.jnt_qposadr[mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_JOINT, n)]] for n in JOINTS], dtype=np.float32)
            qvel = np.array([data.qvel[model.jnt_dofadr[mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_JOINT, n)]] for n in JOINTS], dtype=np.float32)
            contacts = np.array([any(
                (contact.geom1 == foot and contact.geom2 == floor_geom) or
                (contact.geom2 == foot and contact.geom1 == floor_geom)
                for contact in data.contact) for foot in foot_geoms], dtype=np.float32)
            if previous_foot_xy is not None:
                foot_xy = data.site_xpos[foot_sites, :2].copy()
                for foot in range(2):
                    if contacts[foot] and previous_contacts[foot]:
                        max_stance_slip_m = max(
                            max_stance_slip_m,
                            float(np.linalg.norm(foot_xy[foot] - previous_foot_xy[foot])),
                        )
                previous_foot_xy = foot_xy
            else:
                previous_foot_xy = data.site_xpos[foot_sites, :2].copy()
            contact_transitions += int(np.count_nonzero(contacts != previous_contacts))
            previous_contacts = contacts.astype(bool)
            non_foot_collision_count += sum(
                not ((contact.geom1 in foot_geoms and contact.geom2 == floor_geom)
                     or (contact.geom2 in foot_geoms and contact.geom1 == floor_geom))
                for contact in data.contact
            )
            obs = np.concatenate((gyro, accel, np.array([args.vx,0,0,0,0,0,0], dtype=np.float32), qpos-default.astype(np.float32), qvel*0.05, *history, target.astype(np.float32), contacts, phase)).astype(np.float32)
            if obs.size != 101: raise SystemExit(f"observation width {obs.size}")
            action = session.run(None, {"obs": obs[None, :]})[0][0].astype(np.float32)
            if not np.isfinite(action).all(): raise SystemExit("non-finite policy output")
            history = [action, *history[:2]]
            phase_i = (tick // 10 + 1) % GAIT_PHASE_PERIOD
            phase = np.array([math.cos(phase_i / GAIT_PHASE_PERIOD * 2 * math.pi), math.sin(phase_i / GAIT_PHASE_PERIOD * 2 * math.pi)], dtype=np.float32)
            proposed = default + action * 0.25
            limit = 5.24 * 0.02
            target = np.clip(proposed, previous-limit, previous+limit); previous = target.copy()
            delayed_targets.append((tick + args.diagnostic_delay_steps, target.copy()))
            while delayed_targets and delayed_targets[0][0] <= tick:
                _, ready_target = delayed_targets.pop(0); data.ctrl[:] = ready_target
            if tick == 0: obs_fixture, action_fixture = obs.tolist(), action.tolist()
            max_abs_angle = max(max_abs_angle, float(np.max(np.abs(data.qpos[7:]))))
            w,x,y,z=data.qpos[3:7]; roll=math.atan2(2*(w*x+y*z),1-2*(x*x+y*y)); pitch=math.asin(np.clip(2*(w*y-z*x),-1,1))
            min_root_height=min(min_root_height,float(data.qpos[2])); max_abs_roll=max(max_abs_roll,abs(roll)); max_abs_pitch=max(max_abs_pitch,abs(pitch))
            if args.trace_file:
                trace.append({"time_s": tick * model.opt.timestep, "root_position_m": data.qpos[:3].tolist(), "root_roll_rad": roll, "root_pitch_rad": pitch, "joint_position_rad": qpos.tolist(), "joint_target_rad": target.tolist(), "policy_action": action.tolist(), "contacts": contacts.tolist()})
        result = {"run": run, "physics_steps": 4000, "policy_ticks": 400, "command_vx_mps": args.vx, "forward_displacement_m": float(data.qpos[0]-x0), "max_abs_joint_angle_rad": max_abs_angle, "min_root_height_m":min_root_height,"max_abs_roll_rad":max_abs_roll,"max_abs_pitch_rad":max_abs_pitch, "contact_transitions": contact_transitions, "max_stance_slip_m": max_stance_slip_m, "non_foot_collision_count": non_foot_collision_count, "observation_width": len(obs_fixture), "action_width": len(action_fixture), "first_observation": obs_fixture, "first_action": action_fixture, "mode": args.mode}
        if args.diagnostic_delay_steps == 0 and args.diagnostic_drop_policy_tick is None:
            validate_frozen_run(result)
        results.append(result)
        traces.append(trace)
    if renderer is not None:
        renderer.close()
    if args.trace_file:
        args.trace_file.write_text(json.dumps({"joints": JOINTS, "runs": traces}))
    print(json.dumps({"scenario_result": "passed", "contract": {"nq":21,"nv":20,"nu":14,"observation":101,"action":14,"timestep":0.002}, "runs": results}, indent=2))

def run_process_mode(args):
    if args.repeat > 1:
        for _ in range(args.repeat):
            single = argparse.Namespace(**vars(args))
            single.repeat = 1
            run_process_mode(single)
        return
    env = os.environ.copy()
    env["LD_LIBRARY_PATH"] = str(ROOT / ".mujoco/mujoco-3.9.0/lib") + ":" + env.get("LD_LIBRARY_PATH", "")
    procs = []
    ready_file = Path(f"/tmp/soma-open-duck-policy-ready-{os.getpid()}")
    ready_file.unlink(missing_ok=True)
    for socket_path in ("/tmp/soma-open-duck-rt.sock", "/tmp/soma-open-duck-runtime.sock"):
        lock_path = Path(f"{socket_path}.lock")
        owner = lock_path.read_text().strip() if lock_path.exists() else ""
        if not owner or not Path(f"/proc/{owner}").exists():
            Path(socket_path).unlink(missing_ok=True)
            lock_path.unlink(missing_ok=True)
    try:
        # Start the runtime/router first, then let the policy establish its
        # state subscription before the RT owner begins publishing frames.
        procs.append(subprocess.Popen([str(ROOT / "target/debug/open-duck-runtime")], env=env,
                                      stdout=subprocess.DEVNULL, stderr=subprocess.PIPE))
        deadline = time.monotonic() + 5.0
        while time.monotonic() < deadline:
            if (Path("/tmp/soma-open-duck-runtime.sock").exists()
                    and all(proc.poll() is None for proc in procs)):
                break
            time.sleep(0.05)
        if not Path("/tmp/soma-open-duck-runtime.sock").exists():
            errors = [proc.stderr.read().decode(errors="replace") if proc.stderr else "" for proc in procs]
            raise SystemExit("Open Duck runtime/RT did not become ready: " + "\n".join(errors))
        policy_python = ROOT / "python/.venv/bin/python"
        duration = "2" if args.mode == "stall" else "8"
        policy = [str(policy_python), "-m", "soma_client.open_duck_policy", "--duration", duration,
                  "--checkpoint", str(args.checkpoint.resolve()), "--ready-file", str(ready_file),
                  "--vx", str(args.vx)]
        if args.mode == "stall": policy += ["--stall-after", "1"]
        proc = subprocess.Popen(policy, cwd=ROOT / "python", env={**env, "PYTHONPATH": "."},
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        procs.append(proc)
        deadline = time.monotonic() + 5.0
        while time.monotonic() < deadline and not ready_file.exists():
            if proc.poll() is not None:
                break
            time.sleep(0.05)
        if not ready_file.exists():
            raise SystemExit("Open Duck policy did not establish its state subscription")
        # Zenoh declaration is local; allow the router's remote matching state
        # to settle before the RT owner publishes the first policy frame.
        time.sleep(0.25)
        procs.append(subprocess.Popen([str(ROOT / "target/debug/open-duck-rt")], env=env,
                                      stdout=subprocess.DEVNULL, stderr=subprocess.PIPE))
        out, err = proc.communicate(timeout=15)
        if proc.returncode != 0:
            raise SystemExit(err.strip() or "Open Duck policy process failed")
        try:
            evidence = json.loads(out.strip().splitlines()[-1])
        except (json.JSONDecodeError, IndexError):
            raise SystemExit("Open Duck policy process did not report JSON evidence")
        if "complete" not in evidence.get("status", ""):
            raise SystemExit("Open Duck policy process did not report completion")
        if not evidence.get("applied"):
            raise SystemExit("Open Duck process path never observed an applied target")
        if args.mode == "stall" and not evidence.get("expiry"):
            raise SystemExit("Open Duck stall did not observe the expiry transition")
        if args.mode == "policy":
            if evidence["min_root_height_m"] < 0.08:
                raise SystemExit(f"Open Duck process rollout violated root-height floor: {evidence}")
            if evidence["max_abs_roll_rad"] > 0.8 or evidence["max_abs_pitch_rad"] > 0.8:
                raise SystemExit("Open Duck process rollout violated roll/pitch envelope")
        print(json.dumps({"mode": args.mode, "process_path": True, "evidence": evidence}))
    finally:
        owned_pids = {str(proc.pid) for proc in procs}
        for proc in procs:
            if proc.poll() is None: proc.send_signal(signal.SIGINT)
        for proc in procs:
            try: proc.wait(timeout=2)
            except subprocess.TimeoutExpired: proc.kill()
        ready_file.unlink(missing_ok=True)
        for socket_path in ("/tmp/soma-open-duck-rt.sock", "/tmp/soma-open-duck-runtime.sock"):
            lock_path = Path(f"{socket_path}.lock")
            if lock_path.exists() and lock_path.read_text().strip() in owned_pids:
                Path(socket_path).unlink(missing_ok=True)
                lock_path.unlink(missing_ok=True)

if __name__ == "__main__": main()
