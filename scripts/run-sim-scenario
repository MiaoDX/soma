#!/usr/bin/env bash
set -euo pipefail

visualize=false
keep_open=false

usage() {
  cat <<'EOF'
Usage: scripts/run-sim-scenario [--visualize [--keep-open]] [-h|--help]

Run the fixed Reachy Mini simulation acceptance scenario.

Options:
  --visualize  Open the observational MuJoCo and Rerun views and pace the
               scenario for approximately 6 seconds. Both windows close
               automatically when the scenario finishes.
  --keep-open  Keep the visual runtime and both views open after the scenario
               passes. Requires --visualize; press Ctrl-C to stop and clean up.
  -h, --help   Show this help and exit.

Without --visualize, the scenario runs headless and finishes as quickly as
possible. MuJoCo camera controls and Rerun timeline navigation are read-only;
neither viewer can command, pause, step, perturb, or reset the simulation.
EOF
}

for argument in "$@"; do
  case "$argument" in
    --visualize) visualize=true ;;
    --keep-open) keep_open=true ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done

if $keep_open && ! $visualize; then
  echo "error: --keep-open requires --visualize" >&2
  usage >&2
  exit 2
fi

repo_root=$(cd "$(dirname "$0")/.." && pwd)
# shellcheck source=scripts/sim-stack.sh
source "$repo_root/scripts/sim-stack.sh"
trap sim_stack_cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

sim_stack_start "$repo_root" "$visualize" scenario

cd "$repo_root/python"
if $visualize; then
  set +e
  timeout 30 env UV_DEFAULT_INDEX=https://pypi.org/simple uv run python -m soma_client.scenario --visualize
  scenario_status=$?
  set -e
  visualization_status=0
  if ! kill -0 "$sim_stack_observer_pid" 2>/dev/null || ! kill -0 "$sim_stack_rerun_pid" 2>/dev/null; then
    cat "$sim_stack_observer_log" "$sim_stack_rerun_log" >&2
    visualization_status=1
  fi
  if [[ $scenario_status -ne 0 ]]; then exit "$scenario_status"; fi
  if $keep_open && [[ $visualization_status -eq 0 ]]; then
    echo "scenario passed; keeping MuJoCo and Rerun open (press Ctrl-C to stop)"
    while kill -0 "$sim_stack_rt_pid" "$sim_stack_runtime_pid" \
      "$sim_stack_observer_pid" "$sim_stack_rerun_pid" 2>/dev/null; do
      sleep 1
    done
    echo "a visualization process exited while --keep-open was active" >&2
    visualization_status=1
  fi
  exit "$visualization_status"
else
  timeout 15 env UV_DEFAULT_INDEX=https://pypi.org/simple uv run python -m soma_client.scenario
fi
