#!/usr/bin/env bash
set -euo pipefail
if [[ $# -ne 1 ]]; then echo "usage: scripts/build-open-duck-showcase OUTPUT_DIR" >&2; exit 2; fi
repo_root=$(cd "$(dirname "$0")/.." && pwd)
output_dir=$(realpath -m "$1")
if [[ -e $output_dir ]]; then echo "output path already exists: $output_dir" >&2; exit 2; fi
mkdir -p "$output_dir"
metrics=$(mktemp /tmp/soma-open-duck-showcase.XXXXXX.json)
trace=$(mktemp /tmp/soma-open-duck-showcase.XXXXXX.trace.json)
blueprint_dump=$(mktemp /tmp/soma-open-duck-showcase.XXXXXX.blueprint.txt)
trap 'rm -f "$metrics" "$trace" "$blueprint_dump"' EXIT
MUJOCO_GL=egl uv run --project "$repo_root/python" python "$repo_root/scripts/run-open-duck-walk" \
  reference --showcase --frames-dir "$output_dir/frames" --trace-file "$trace" >"$metrics"
commit=$(git -C "$repo_root" rev-parse HEAD)
generated=$(date -u +%Y-%m-%dT%H:%M:%SZ)
cd "$repo_root/python"
uv run --extra visualization python - "$metrics" "$trace" "$output_dir/evidence.rrd" <<'PY'
import json, pathlib, sys
import mujoco
import rerun as rr
import rerun.blueprint as rrb
from rerun_loader_mjcf import MJCFLogger, MJCFRecorder
data=json.loads(pathlib.Path(sys.argv[1]).read_text())
trace=json.loads(pathlib.Path(sys.argv[2]).read_text())
rr.init("Soma Open Duck Mini", recording_id="open-duck-showcase")
run=data["runs"][0]; samples=trace["runs"][0]; prefix="rollout/timeseries"
if not all(len(sample["response"]) == 3 for sample in samples):
    raise SystemExit("Open Duck trace lacks the three-axis base velocity response")
for sample in samples:
    rr.set_time("sim_time", duration=sample["time_s"])
    rr.log(f"{prefix}/root/x_m", rr.Scalars([sample["root_position_m"][0]]))
    rr.log(f"{prefix}/root/height_m", rr.Scalars([sample["root_position_m"][2]]))
    rr.log(f"{prefix}/root/roll_rad", rr.Scalars([sample["root_roll_rad"]]))
    rr.log(f"{prefix}/root/pitch_rad", rr.Scalars([sample["root_pitch_rad"]]))
    rr.log(f"{prefix}/command/vx_mps", rr.Scalars([sample["command"][0]]))
    rr.log(f"{prefix}/command/vy_mps", rr.Scalars([sample["command"][1]]))
    rr.log(f"{prefix}/command/yaw_rps", rr.Scalars([sample["command"][2]]))
    rr.log(f"{prefix}/response/vx_mps", rr.Scalars([sample["response"][0]]))
    rr.log(f"{prefix}/response/vy_mps", rr.Scalars([sample["response"][1]]))
    rr.log(f"{prefix}/response/yaw_rps", rr.Scalars([sample["response"][2]]))
    rr.log(f"{prefix}/contacts/left", rr.Scalars([sample["contacts"][0]]))
    rr.log(f"{prefix}/contacts/right", rr.Scalars([sample["contacts"][1]]))
    for joint, position, target, action in zip(trace["joints"], sample["joint_position_rad"], sample["joint_target_rad"], sample["policy_action"]):
        rr.log(f"{prefix}/joints/{joint}/position_rad", rr.Scalars([position]))
        rr.log(f"{prefix}/joints/{joint}/target_rad", rr.Scalars([target]))
        rr.log(f"{prefix}/actions/{joint}", rr.Scalars([action]))
model=mujoco.MjModel.from_xml_path(str(pathlib.Path("../crates/soma-sim/assets/open-duck-mini-v2/xmls/scene_flat_terrain.xml")))
md=mujoco.MjData(model); rr.set_time("sim_time", duration=0.0)
logger=MJCFLogger(model, entity_path_prefix="robot"); logger.log_model()
with MJCFRecorder(logger, timeline_name="sim_time") as recorder:
    for sample in samples:
        md.qpos[:]=sample["qpos"]; md.qvel[:]=sample["qvel"]; md.time=sample["time_s"]
        mujoco.mj_forward(model, md); recorder.record(md, duration=sample["time_s"])
spatial=rrb.Spatial3DView(
        origin="robot",
        contents=["/robot/**", "-/robot/visual_geometries/floor/**"],
        name="Open Duck Mini",
        eye_controls=rrb.EyeControls3D(
            position=(0.6, -2.0, 0.62),
            look_target=(0.6, 0.1, 0.22),
            eye_up=(0.0, 0.0, 1.0),
        ),
    )
telemetry=rrb.Vertical(
    rrb.TimeSeriesView(
        contents=[
            "/rollout/timeseries/command/vx_mps",
            "/rollout/timeseries/command/vy_mps",
            "/rollout/timeseries/response/vx_mps",
            "/rollout/timeseries/response/vy_mps",
        ],
        name="Planar velocity",
    ),
    rrb.TimeSeriesView(
        contents=[
            "/rollout/timeseries/command/yaw_rps",
            "/rollout/timeseries/response/yaw_rps",
        ],
        name="Yaw rate",
    ),
    rrb.TimeSeriesView(
        contents=[
            "/rollout/timeseries/root/height_m",
            "/rollout/timeseries/root/roll_rad",
            "/rollout/timeseries/root/pitch_rad",
        ],
        name="Base stability",
    ),
    rrb.TimeSeriesView(origin="rollout/timeseries/contacts", name="Foot contacts"),
)
rr.send_blueprint(rrb.Blueprint(rrb.Horizontal(spatial, telemetry, column_shares=[1.15, 1.0])))
rr.save(sys.argv[3])
PY
cd "$repo_root"
rrd_url="https://miaodx.com/soma/open-duck/evidence.rrd"
ffmpeg=$(cd "$repo_root/python" && UV_DEFAULT_INDEX=https://pypi.org/simple \
  uv run --project "$repo_root/python" --extra visualization python -c 'import imageio_ffmpeg; print(imageio_ffmpeg.get_ffmpeg_exe())')
cp "$output_dir/frames/frame-0000.ppm" "$output_dir/poster.ppm"
frame_count=$(find "$output_dir/frames" -name 'frame-*.ppm' | wc -l)
"$ffmpeg" -hide_banner -loglevel error -i "$output_dir/poster.ppm" -frames:v 1 -y "$output_dir/poster.png"
"$ffmpeg" -hide_banner -loglevel error -framerate "$frame_count/12" -i "$output_dir/frames/frame-%04d.ppm" -c:v libvpx-vp9 -pix_fmt yuv420p -an -y "$output_dir/motion.webm"
rm -f "$output_dir/poster.ppm"
rm -rf "$output_dir/frames"
rows=$(python3 - "$metrics" <<'PY'
import json,sys
r=json.load(open(sys.argv[1]))["runs"][0]
print(f"<p>Forward displacement: <strong>{r['forward_displacement_m']:.5f} m</strong>; minimum root height: <strong>{r['min_root_height_m']:.5f} m</strong>; foot contact transitions: <strong>{r['contact_transitions']}</strong>.</p>")
PY
)
python3 - "$repo_root/docs/showcase/open-duck.template.html" "$output_dir/index.html" "$commit" "$rrd_url" "$rows" <<'PY'
import pathlib,sys
template=pathlib.Path(sys.argv[1]).read_text()
for key,value in (("@@COMMIT@@",sys.argv[3]),("@@RRD_URL@@",sys.argv[4]),("@@ROWS@@",sys.argv[5])):
 template=template.replace(key,value)
pathlib.Path(sys.argv[2]).write_text(template)
PY
python3 - "$output_dir/metadata.json" "$commit" "$generated" "$metrics" <<'PY'
import json, pathlib, sys
metrics=json.loads(pathlib.Path(sys.argv[4]).read_text())
json.dump({"schema_version":1,"robot":"Open Duck Mini","scope":"simulation-only","scenario":"single 12-second composite showcase rollout","scenario_result":metrics["scenario_result"],"commit":sys.argv[2],"generated_utc":sys.argv[3],"renderer":{"engine":"MuJoCo EGL offscreen","camera":"fixed path overview","width":640,"height":480},"artifacts":{"poster":"poster.png","motion":"motion.webm","rerun":"evidence.rrd"},"run":metrics["runs"][0]},open(sys.argv[1],"w"),indent=2)
PY
UV_DEFAULT_INDEX=https://pypi.org/simple uv run --project "$repo_root/python" \
  --extra visualization rerun rrd verify "$output_dir/evidence.rrd"
python3 - "$output_dir" "$ffmpeg" <<'PY'
import pathlib, re, subprocess, sys
d = pathlib.Path(sys.argv[1]); ffmpeg = sys.argv[2]
png = (d / "poster.png").read_bytes()
assert png[:8] == b"\x89PNG\r\n\x1a\n"
assert (int.from_bytes(png[16:20], "big"), int.from_bytes(png[20:24], "big")) == (640, 480)
probe = subprocess.run([ffmpeg, "-hide_banner", "-i", str(d / "motion.webm"), "-f", "null", "-"], stderr=subprocess.PIPE, text=True)
duration = re.search(r"Duration: (\d+):(\d+):(\d+(?:\.\d+)?)", probe.stderr)
assert duration and 12.0 <= float(duration[3]) <= 12.2
hashes = subprocess.check_output([ffmpeg, "-hide_banner", "-loglevel", "error", "-i", str(d / "motion.webm"), "-f", "framemd5", "-"], text=True)
assert len({line.rsplit(",", 1)[-1].strip() for line in hashes.splitlines() if line and not line.startswith("#")}) > 1
html = (d / "index.html").read_text()
assert "https://miaodx.com/soma/open-duck/evidence.rrd" in html
assert "miaodx.github.io" not in html
assert 'loading="eager"' in html and 'loading="lazy"' not in html
assert "persist=false" in html
meta = __import__("json").loads((d / "metadata.json").read_text())
assert meta["scenario"] == "single 12-second composite showcase rollout"
assert "run" in meta and "runs" not in meta
assert meta["run"]["physics_steps"] == 6000
PY
robot_mesh=$(cd "$repo_root/python" && UV_DEFAULT_INDEX=https://pypi.org/simple \
  uv run --extra visualization rerun rrd print "$output_dir/evidence.rrd")
(cd "$repo_root/python" && UV_DEFAULT_INDEX=https://pypi.org/simple \
  uv run --extra visualization rerun rrd print -vvv "$output_dir/evidence.rrd" \
  > "$blueprint_dump")
[[ $robot_mesh == *"/robot/visual_geometries/"*"Mesh3D:triangle_indices"* ]] || {
  echo "Open Duck Rerun archive lacks robot mesh geometry" >&2
  exit 1
}
[[ $robot_mesh == *"CoordinateFrame:frame"* ]] || {
  echo "Open Duck Rerun meshes are not attached to body coordinate frames" >&2
  exit 1
}
visual_root=$(cd "$repo_root/python" && UV_DEFAULT_INDEX=https://pypi.org/simple \
  uv run --extra visualization rerun rrd print --entity /robot/visual_geometries/base "$output_dir/evidence.rrd")
[[ $visual_root != *"Transform3D:"* ]] || {
  echo "Open Duck visual hierarchy contains a duplicate body transform" >&2
  exit 1
}
for stream in vx_mps vy_mps yaw_rps; do
  [[ $robot_mesh == *"/rollout/timeseries/command/$stream - data columns: [Scalars:scalars]"* ]] || {
    echo "Open Duck Rerun archive lacks command stream: $stream" >&2
    exit 1
  }
  [[ $robot_mesh == *"/rollout/timeseries/response/$stream - data columns: [Scalars:scalars]"* ]] || {
    echo "Open Duck Rerun archive lacks response stream: $stream" >&2
    exit 1
  }
done
for view in "Planar velocity" "Yaw rate" "Base stability" "Foot contacts"; do
  grep -Fq "[$view]" "$blueprint_dump" || {
    echo "Open Duck Rerun blueprint lacks semantic view: $view" >&2
    exit 1
  }
done
for stale_view in "Velocity commands" "Root motion and stability" \
  "Joint positions and targets" "Policy actions"; do
  if grep -Fq "[$stale_view]" "$blueprint_dump"; then
    echo "Open Duck Rerun blueprint still exposes stale default view: $stale_view" >&2
    exit 1
  fi
done
robot_motion=$(cd "$repo_root/python" && UV_DEFAULT_INDEX=https://pypi.org/simple \
  uv run --extra visualization rerun rrd print -vvv --entity /robot/bodies/base "$output_dir/evidence.rrd")
[[ $robot_motion == *"PT11."* ]] || {
  echo "Open Duck robot transforms do not span the composite rollout" >&2
  exit 1
}
echo "Open Duck showcase built: $output_dir"
