{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "required": ["record_type", "schema_version", "implementation", "actuator_order", "units", "capabilities"],
      "properties": {
        "record_type": {"const": "manifest"},
        "schema_version": {"const": 2},
        "implementation": {"enum": ["soma", "official"]},
        "actuator_order": {"const": ["yaw_body", "stewart_1", "stewart_2", "stewart_3", "stewart_4", "stewart_5", "stewart_6", "right_antenna", "left_antenna"]},
        "units": {"const": "radians"},
        "initial_positions_rad": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "number"}},
        "capabilities": {"type": "object"}
      }
    },
    {
      "type": "object",
      "required": ["record_type", "implementation", "planned_sample_index", "planned_deadline_monotonic_ns", "lateness_ns", "host_observed_monotonic_ns", "host_command_sent_monotonic_ns", "target_positions_rad", "measured_positions_rad", "provenance"],
      "properties": {
        "record_type": {"const": "sample"},
        "planned_sample_index": {"type": "integer", "minimum": 0, "maximum": 99},
        "planned_deadline_monotonic_ns": {"type": "integer", "minimum": 0},
        "lateness_ns": {"type": "integer"},
        "implementation": {"enum": ["soma", "official"]},
        "host_observed_monotonic_ns": {"type": "integer", "minimum": 0},
        "host_command_sent_monotonic_ns": {"type": "integer", "minimum": 0},
        "target_positions_rad": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "number"}},
        "measured_positions_rad": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "number"}},
        "provenance": {"type": "object"}
      }
    }
  ]
}
